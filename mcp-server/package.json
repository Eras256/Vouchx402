{
  "name": "vouch402-mcp-server",
  "version": "0.1.0",
  "description": "Standalone MCP server for Vouch402: x402-metered on-chain risk scores for Base addresses, with EAS fulfillment attestations. Never holds a wallet or signs transactions itself.",
  "type": "module",
  "bin": {
    "vouch402-mcp-server": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pretest": "npm run build",
    "test": "vitest run"
  },
  "keywords": ["x402", "base", "eas", "attestation", "risk-score", "mcp", "model-context-protocol"],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Eras256/Vouchx402.git",
    "directory": "mcp-server"
  },
  "dependencies": {
    "vouch402-sdk": "file:../sdk",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.3",
    "viem": "2.55.13",
    "vitest": "^4.1.10"
  }
}

# Base network
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Which network the server currently operates on: "base-sepolia" | "base"
NETWORK=base-sepolia

# Deployment / signing: NEVER put real keys in this file.
# Use Foundry's encrypted keystore (`cast wallet import`) and reference
# the keystore account name, not a raw private key.
DEPLOYER_KEYSTORE_ACCOUNT=
DEPLOYER_KEYSTORE_PASSWORD=

# CDP (testnet faucet, optional programmatic funding)
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# Base Builder Code (from base.dev -> Settings -> Builder Code)
BASE_BUILDER_CODE=

# Filled in after Phase 2 (EAS schema registration); separate per network
EAS_SCHEMA_UID_FULFILLMENT_SEPOLIA=
EAS_SCHEMA_UID_DISPUTE_SEPOLIA=
EAS_SCHEMA_UID_FULFILLMENT_MAINNET=
EAS_SCHEMA_UID_DISPUTE_MAINNET=

# Server
PORT=3402

# Receiving ("treasury") address for USDC payments, deliberately
# separate from the deployer/signer wallet above (see DECISION_LOG.md):
# the signer's key lives on the server and has to be "hot"; payTo is
# where revenue actually accumulates and should be an address you
# control directly, not the server-generated wallet.
# X402_PAY_TO_ADDRESS is the legacy single value (still used as the
# Sepolia fallback below if _SEPOLIA isn't set). Mainnet has NO fallback:
# it will refuse to start serving mainnet requests until
# X402_PAY_TO_ADDRESS_MAINNET is set explicitly.
X402_PAY_TO_ADDRESS=
X402_PAY_TO_ADDRESS_SEPOLIA=
X402_PAY_TO_ADDRESS_MAINNET=

# USDC contract addresses (public, well-known)
USDC_ADDRESS_BASE_SEPOLIA=0x036CbD53842c5426634e7929541eC2318f3dCF7e
USDC_ADDRESS_BASE_MAINNET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Price per risk-score request, in USDC (e.g. "0.01")
PRICE_USDC=0.01

# SQLite storage path
DB_PATH=./data/vouch402.sqlite
